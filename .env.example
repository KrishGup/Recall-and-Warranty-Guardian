# Guardian environment. Copy to `.env` at the repo root (gitignored) and fill in what you have.
# `guardian serve`, `guardian sweep`, the tests' fixtures and scripts/aws_check.py load it automatically
# (a variable already set in the shell wins). See docs/AWS_SETUP.md for how to obtain each value.

# ---- AWS (required for Bedrock, AgentCore, SES, SNS, S3) --------------------------------------------------------
# Region with Bedrock Claude access and AgentCore Runtime. us-east-1 is the safe choice.
AWS_REGION=us-east-1
# Either an IAM user's access key pair for the hackathon (delete the key when it ends)...
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# ...or an IAM Identity Center / SSO profile from `aws configure sso` (then leave the two keys above empty):
# AWS_PROFILE=guardian
AWS_ACCOUNT_ID=

# ---- Bedrock models ---------------------------------------------------------------------------------------------
# gren maps haiku/sonnet/opus to cross-region inference profiles (global.anthropic.claude-haiku-4-5, ...).
# Run `python scripts/aws_check.py`: it prints the profile ids your region exposes; set these only if they differ.
# GREN_BEDROCK_HAIKU=global.anthropic.claude-haiku-4-5
# GREN_BEDROCK_SONNET=global.anthropic.claude-sonnet-5
# GREN_BEDROCK_OPUS=global.anthropic.claude-opus-5
# Force a provider instead of letting gren pick (bedrock | anthropic | claude-code | mock). Leave unset for auto.
# GREN_BRIDGE=bedrock

# ---- Email and SMS ----------------------------------------------------------------------------------------------
# A sender identity verified in SES for AWS_REGION. While the SES account is in the sandbox, recipients must be
# verified identities too. Unset = remedy emails go to var/household/outbox.
GUARDIAN_SES_FROM=
# Redirect every outgoing email here while set (demos, sandbox): a test run must never email a real manufacturer.
GUARDIAN_SES_TO_OVERRIDE=
# Bedrock-only credential (Bedrock console → API keys → long-term). Enough for the sweep; not for SES/S3/AgentCore.
# AWS_BEARER_TOKEN_BEDROCK=
# Set to 1 to publish SMS through SNS. US destinations need a registered origination number; unset = outbox.
# GUARDIAN_SNS=1

# Hard stop on model spend per day: sweeps and intake refuse to start once today's recorded run cost reaches it.
# AWS Budgets only alert (a budget action can restrict an IAM user, never the root user); gren's max_cost_usd bounds one run.
GUARDIAN_DAILY_BUDGET_USD=10

# ---- Optional keys ----------------------------------------------------------------------------------------------
# openFDA: free key raises the enforcement API limit from 1,000 to 120,000 requests a day.
OPENFDA_API_KEY=
# Anthropic API instead of Bedrock (gren prefers it when set): leave empty when using Bedrock.
# ANTHROPIC_API_KEY=

# ---- Gmail linking (guardian/gmail.py; Settings > Gmail) -----------------------------------------------------
# Optional: without these, Settings still shows the zero-OAuth forwarding-filter fallback (Preferences.forwarding_address).
# To enable the "Connect Gmail" button: console.cloud.google.com -> new project -> APIs & Services -> OAuth consent
# screen (External, Testing is fine) -> Credentials -> Create OAuth client ID (Web application) -> add
# GOOGLE_REDIRECT_URI below as an authorized redirect URI -> Library -> enable the Gmail API.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/api/gmail/callback

# ---- Deployment (docs/AWS_SETUP.md section 6) --------------------------------------------------------------------
# State bucket (private). The EC2 deployment mirrors the store there after every change and stores releases + config.
# GUARDIAN_S3_BUCKET=guardian-<account>-state
# GUARDIAN_S3_PREFIX=guardian
# Set to 1 only on a server: pull the bucket copy at start and push after every change. Never on a developer machine.
# GUARDIAN_STATE_SYNC=1
# Gate every action (POST/PUT/DELETE on /api and /gren/api) behind a token once the dashboard is reachable from outside;
# reads stay open. `scripts/deploy_ec2.py up` generates it and writes GUARDIAN_URL next to it.
# GUARDIAN_API_TOKEN=
# GUARDIAN_URL=https://guardian.<ip-with-dashes>.sslip.io
# Knobs for deploy_ec2.py: instance type, what the server runs on (feeds/bridge), the wildcard DNS suffix.
# GUARDIAN_EC2_TYPE=t3.small
# GUARDIAN_DEPLOY_FEEDS=live
# GUARDIAN_DEPLOY_BRIDGE=bedrock      # anthropic = run the server on the Anthropic API (ANTHROPIC_API_KEY is shipped along)
# GUARDIAN_WILDCARD_DNS=sslip.io
# AgentCore mode (deploy/agentcore; needs the quotas raised by Support first): with the ARN set, `guardian serve` sends
# sweeps, answers and intake to the runtime and serves reads from the state pulled back from S3 after each call.
# GUARDIAN_AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:123456789012:runtime/guardian-XXXX

# ---- Local paths (defaults shown) -------------------------------------------------------------------------------
# GUARDIAN_DATA=var/household
# GUARDIAN_RUNS=var/runs
# GUARDIAN_FEEDS=live            # fixtures = replay the recorded feeds
# GREN_API_TOKEN=                # protect /gren/api when the server is exposed beyond localhost
